program treg;

 var x1, x2, x3, y1, y2, y3, a, b, c :real;
 var flag, pramik, genii :boolean;
   valerka:boolean;
 var zn:char;
begin
     while true do begin
     writeln('Начало - 1');
     writeln('Выход - 2');
     readln(zn);
     case zn of
     '1': begin

     x1:=0;
     x2:=0;
     y3:=0;
     y2:=0;
     y3:=0;
     a:=0;
     b:=0;
     c:=0;

     pramik:=false;
     valerka:=false;
     flag:=false;
     genii:=false;

     writeln('Введите x для точки А');
     readln(x1);
     writeln('Введите y для точки А');
     readln(y1);
     writeln();

     writeln('Введите x для точки B');
     readln(x2);
     writeln('Введите y для точки B');
     readln(y2);
     writeln();

     writeln('Введите x для точки C');
     readln(x3);
     writeln('Введите y для точки C');
     readln(y3);

     a := sqrt(( sqr(x2-x1) + sqr(y2-y1) ));
     b := sqrt(( sqr(x3-x2) + sqr(y3-y2) ));
     c := sqrt(( sqr(x3-x1) + sqr(y3-y1) ));
     //writeln(a:8:3, b:8:3, c:8:3);

     //writeln();
     //writeln();

     if (((x2 - x1)=0) or ((y2 - y1)=0)) then begin genii:=false; writeln('Неверный ввод') end
     else genii:=true;


     if (genii=true) and (((x3 - x1) / (x2 - x1) = (y3 - y1) / (y2 - y1))) then begin
         valerka:=false;
     end
     else valerka:=true;

     if (valerka=true) and (genii=true) then begin

     if a+b>=c then
        begin
        if b+c>=a then
           begin
               if a+c>=b then
                  begin
                      writeln();
                      writeln();
                      writeln();
                      writeln('Тругольник существует');
                      flag := true;
                  end
           end
        end
     else
     begin
         writeln();
         writeln();
         writeln();
         writeln('Тругольник не сушествует');
         flag := false;
     end;



     if (flag = true) then
        begin

            if ((a=b) and (b=c)) then
               begin
                   writeln('Равносторонний треугольник');
               end
            else if ((a=b) or (a=c) or (b=c)) then
                   begin
                       writeln('Равнобедренный треугольник');
                   end
            else writeln('Все его стороны разные');

            if ((sqrt(sqr(a)+ sqr(c))) = b) then pramik:=true;
            if ((sqrt(sqr(b)+ sqr(c))) = a) then pramik:=true;
            if ((sqrt(sqr(a)+ sqr(b))) = c) then pramik:=true;

            if  pramik = true  then

                   begin
                       writeln('Прямоугольный треугольник');
                   end
            else
                writeln('Не прямоугольный треугольник');
        end;
     end
     else writeln('Невозможно создать треугольник');

     readln();
     end;

     '2':exit;
     end;
     end;
end.
